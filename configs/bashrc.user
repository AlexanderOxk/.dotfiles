# aliases
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ll='\ls -ahlF --color=auto'

alias bashrc='nvim ${HOME}/.bashrc.user'
alias vim='nvim'
alias py='python3'
alias python='python3'
alias network-share='hostname -I && python3 -m http.server'
alias shutdown='systemctl poweroff'
alias tmux='unset __ETC_PROFILE_NIX_SOURCED && tmux'
alias vivado='distrobox enter vivado -- /home/ubuntu/tools/vivado/2025.2/Vivado/bin/vivado'

alias icat='kitty +kitten icat'

# History
HIST_FILE_PATH="${HOME}/.cache/bash_history"
HISTFILE=$HIST_FILE_PATH
HISTSIZE=10000
HISTFILESIZE=10000
# HIST_CLEANER_CLEAN_PATTERNS="${HOME}/.config/hclean/clean_patterns"
# HIST_CLEANER_CMD="hclean -e 10 -c ${HIST_CLEANER_CLEAN_PATTERNS} ${HIST_FILE_PATH}"
HISTIGNORE="hg *"

# Exports
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
export LOCALE_ARCHIVE="$(nix-env --installed --no-name --out-path --query glibc-locales)/lib/locale/locale-archive"
export RUSTUP_HOME="$HOME/.local/share/rust/rustup"
export CARGO_HOME="$HOME/.local/share/rust/cargo"

# Functions
# go to git top ('cd -' goes back)
cdg () {
    TEMP_PWD=$PWD
    while ! [ -d .git ]; do
        cd ..
    done
    OLDPWD=$TEMP_PWD
}

function hg {
    if [ "$#" -ne 1 ]; then
        echo "Type search string."
    else
        history | grep --color -- "$1"
    fi
}


__prompt_command() {
    # Prompt coloring
    local EXIT="$?"                # This needs to be first
    PS1=""

    local RCol='\[\e[0m\]'

    local Red='\[\e[1;31m\]'
    local Blue='\[\033[01;34m\]'

    local __user_and_host="\[\033[01;32m\]\u@\h"
    local __cur_location="\[\033[01;34m\]\w"
    local __git_branch_color="\[\033[31m\]"
    local __git_branch='`git branch 2> /dev/null | grep -e ^* | sed -E s/^\\\\\*\ \(.+\)$/\(\\\\\1\)\ /`'
    local __prompt_tail="\[\033[35m\]$"
    local __last_color="\[\033[00m\]"

    if [ $EXIT != 0 ]; then
        PS1+="${Red}[${EXIT}] ${RCol}"        # Add red if exit code non 0
    fi

    if [[ -n $IN_NIX_SHELL ]]; then
        PS1+="${Blue}[nix]${RCol}"
    fi

    PS1+="$__user_and_host $__cur_location $__git_branch_color$__git_branch$__prompt_tail$__last_color "
    # End prompt colors

    # ${HIST_CLEANER_CMD}
    # history -a
}

PROMPT_COMMAND=__prompt_command

